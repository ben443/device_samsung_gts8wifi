import /init.recovery.services.qcom_decrypt.rc
import /init.recovery.qcom_decrypt.fbe.rc

on fs
    # needed to make qseecomd work in recovery
    chmod 0660 /dev/qseecom
    chown system drmrpc /dev/qseecom
    chmod 0664 /dev/ion
    chown system system /dev/ion

on property:ro.crypto.state=encrypted && property:ro.boot.dynamic_partitions=true
    start prepdecrypt

on property:crypto.ready=1 && property:hwservicemanager.ready=true
    start qseecomd

on property:sys.listeners.registered=true && property:keymaster_ver=3.0
    start keymaster-3-0
    start keymaster-3-0-qti

on property:sys.listeners.registered=true && property:keymaster_ver=4.0
    start keymaster-4-0
    start keymaster-4-0-qti

on property:sys.listeners.registered=true && property:keymaster_ver=4.1
    start keymaster-4-1
    start keymaster-4-1-qti
    start keymaster-4-1-citadel

on property:sys.listeners.registered=true && property:keymaster_ver=4.x
    start keymaster-4-0
    start keymaster-4-0-qti
    start keymaster-4-1
    start keymaster-4-1-qti
    start keymaster-4-1-citadel

on property:vendor.sys.listeners.registered=true && property:keymaster_ver=3.0
    start keymaster-3-0
    start keymaster-3-0-qti

on property:vendor.sys.listeners.registered=true && property:keymaster_ver=4.0
    start keymaster-4-0
    start keymaster-4-0-qti

on property:vendor.sys.listeners.registered=true && property:keymaster_ver=4.1
    start keymaster-4-1
    start keymaster-4-1-qti
    start keymaster-4-1-citadel

on property:vendor.sys.listeners.registered=true && property:keymaster_ver=4.x
    start keymaster-4-0
    start keymaster-4-0-qti
    start keymaster-4-1
    start keymaster-4-1-qti
    start keymaster-4-1-citadel

on property:ro.crypto.type=block && property:ro.crypto.fs_crypto_blkdev=*
    setprop crypto.ready 0
    stop qseecomd
    stop keymaster-3-0
    stop keymaster-3-0-qti
    stop keymaster-4-0
    stop keymaster-4-0-qti
    stop keymaster-4-1
    stop keymaster-4-1-qti
    stop keymaster-4-1-citadel

service prepdecrypt /system/bin/prepdecrypt.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

service qseecomd /system/bin/qseecomd
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    disabled
    oneshot
    seclabel u:r:recovery:s0

service keymaster-3-0 /system/bin/android.hardware.keymaster@3.0-service
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    disabled
    oneshot
    seclabel u:r:recovery:s0

service keymaster-3-0-qti /system/bin/android.hardware.keymaster@3.0-service-qti
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    disabled
    oneshot
    seclabel u:r:recovery:s0

service keymaster-4-0 /system/bin/android.hardware.keymaster@4.0-service
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    disabled
    oneshot
    seclabel u:r:recovery:s0

service keymaster-4-0-qti /system/bin/android.hardware.keymaster@4.0-service-qti
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    disabled
    oneshot
    seclabel u:r:recovery:s0

service keymaster-4-1 /system/bin/android.hardware.keymaster@4.1-service
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    disabled
    oneshot
    seclabel u:r:recovery:s0

service keymaster-4-1-qti /system/bin/android.hardware.keymaster@4.1-service-qti
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    disabled
    oneshot
    seclabel u:r:recovery:s0

service keymaster-4-1-citadel /system/bin/android.hardware.keymaster@4.1-service.citadel
    disabled
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    seclabel u:r:recovery:s0
